rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kullanıcılar kendi dokümanlarını okuyup yazabilir.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ekipler (Teams) ve altındaki tüm koleksiyonlar
    match /teams/{teamId} {
      // Herkes ekip detaylarını okuyabilir
      allow read: if request.auth != null;
      
      // Sadece kurucu ekip dokümanını güncelleyebilir
      allow update, delete: if request.auth != null && resource.data.kurucu == request.auth.uid;
      allow create: if request.auth != null;
      
      // Ekip altındaki koleksiyonlar (santiyeler, raporlar, isciler vb.)
      match /{document=**} {
        // Ekip üyeleri okuyabilir
        allow read: if request.auth != null;
        
        // Sadece kurucu veya yöneticiler yazabilir/silebilir
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.kurucu == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.yoneticiler
        );
      }
    }
  }
}
