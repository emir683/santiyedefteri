rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GÜVENLİK YARDIMCI FONKSİYONLARI ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getTeamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    
    function isTeamMember(teamId) {
      let teamData = getTeamData(teamId);
      return isAuthenticated() && teamData != null && (
        request.auth.uid == teamData.kurucu ||
        ('uyeler' in teamData && request.auth.uid in teamData.uyeler)
      );
    }

    function isTeamAdmin(teamId) {
      let teamData = getTeamData(teamId);
      return isAuthenticated() && teamData != null && (
        request.auth.uid == teamData.kurucu ||
        ('yoneticiler' in teamData && teamData.yoneticiler != null && request.auth.uid in teamData.yoneticiler)
      );
    }

    // 1. KULLANICI PROFİLLERİ (USERS)
    match /users/{userId} {
      // Kullanıcı adı ile giriş sorgusu, benzersizlik kontrolü ve ekip üyesi listeleme için
      allow read: if true;
      
      // Kullanıcı sadece kendi profilini oluşturabilir ve silebilir
      allow create, delete: if isOwner(userId);
      
      // Güncelleme:
      // - Kullanıcı kendi profilini güncelleyebilir
      // - VEYA kullanıcının mevcut ekibinin kurucusu/yöneticisi üyeyi ekipten çıkarırken sadece 'teamId' alanını null yapabilir
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']) &&
          resource.data.teamId != null &&
          isTeamAdmin(resource.data.teamId)
        )
      );
      
      // Kullanıcıya özel yapay zeka kullanım sayaçları (başkası asla erişemez)
      match /ai_usage/{usageId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. UYGULAMA YAPILANDIRMASI (APP CONFIG)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false; // Sadece Firebase Console üzerinden yönetilir
    }

    // 3. EKİP YÖNETİMİ (TEAMS)
    match /teams/{teamId} {
      // Ekip arama, şifre ile katılma veya davet bağlantısı doğrulama için
      allow read: if isAuthenticated();
      
      // Yeni ekip oluşturma: oluşturan kişi kurucu olmalıdır
      allow create: if isAuthenticated() && request.resource.data.kurucu == request.auth.uid;
      
      // Ekip güncelleme:
      // - Kurucu veya ekip yöneticisi güncelleyebilir
      // - VEYA bir kullanıcı ekibe katılırken/ayrılırken sadece 'uyeler' dizisini değiştirebilir
      // - VEYA bir yönetici ekipten ayrılırken sadece kendi UID'sini 'uyeler' ve 'yoneticiler' dizilerinden çıkarabilir (yetki yükseltme engellenir)
      allow update: if isAuthenticated() && (
        resource.data.kurucu == request.auth.uid ||
        (resource.data.yoneticiler != null && request.auth.uid in resource.data.yoneticiler) ||
        (
          resource.data.isPersonal != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uyeler'])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uyeler', 'yoneticiler']) &&
          !(request.auth.uid in request.resource.data.uyeler) &&
          !(request.auth.uid in request.resource.data.yoneticiler)
        )
      );
      
      // Sadece kurucu ekibi tamamen silebilir
      allow delete: if isAuthenticated() && resource.data.kurucu == request.auth.uid;
      
      // 4. EKİP ALT VERİLERİ (Şantiyeler, İşçiler, Günlük Raporlar, Finans, Avanslar, Ödemeler, Geçmiş)
      // KRİTİK GÜVENLİK BARİYERİ: Yabancı ekipler veya yabancı kullanıcılar bu verilere ASLA ERİŞEMEZ!
      match /{subcollection}/{document=**} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamMember(teamId);
      }
    }

    // 5. GERİ BİLDİRİMLER (FEEDBACKS & PUANLAMA)
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Sadece Firebase Console/Admin erişebilir
    }
  }
}
